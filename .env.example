# Runtime
NODE_ENV=production
PORT=5000
BACKEND_IP=0.0.0.0

# Database
# Phase 3 uses MongoDB transactions for atomic capacity reservations. Use Atlas or another replica-set/sharded deployment with transaction support.
DATABASE_URL=mongodb+srv://USER:PASSWORD@HOST/DATABASE

# Browser / CORS
# Primary browser origin (no trailing slash).
FRONTEND_URL=https://www.example.com
# Comma-separated additional trusted origins, if any.
CORS_ORIGINS=https://example.com,https://admin.example.com

# Authentication
# Generate independent random values with at least 32 bytes of entropy.
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
REMEMBER_ME_REFRESH_TOKEN_TTL_DAYS=30

# Cookies
COOKIE_SECURE=true
# Use lax when the frontend and API are same-site. If they are truly cross-site,
# use none together with COOKIE_SECURE=true and an exact CORS allowlist.
COOKIE_SAME_SITE=lax
# Optional. Leave unset for host-only cookies (recommended by default).
# COOKIE_DOMAIN=.example.com

# Redis (Upstash Redis with TLS)
# Obtain from Upstash Console -> Details -> Connect -> ioredis / Node.js
# Format: rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379
# Fallback local redis for offline development:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# Mail (the current mail service uses Gmail credentials)
EMAIL_USERNAME=no-reply@example.com
EMAIL_PASSWORD=replace-with-an-app-password

# Cloudflare R2 Object Storage (Images are auto-compressed to WebP)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=bio-cleaning-media
# Public CDN URL (e.g., https://pub-xxxx.r2.dev or custom domain https://media.yourdomain.com)
R2_PUBLIC_URL=https://pub-yourbucketid.r2.dev

# Stripe Payments
STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
CRYPTO_SECRET_KEY=replace-me

# Customer portal / communications (Phase 7)
PORTAL_SESSION_DAYS=30
PORTAL_MAGIC_LINK_MINUTES=20
# Persistent API instances process the outbox automatically. Cloud schedulers
# can also POST /api/v1/communications/cron with X-Cron-Secret.
NOTIFICATION_WORKER_INTERVAL_MS=5000
NOTIFICATION_MAX_ATTEMPTS=5
# Best-effort in-process lifecycle sweep for persistent Cloud Run/VM instances.
# Keep the protected /communications/cron endpoint wired to Cloud Scheduler for guaranteed execution when instances may scale to zero.
RETENTION_SWEEP_INTERVAL_MS=300000
COMMUNICATIONS_CRON_SECRET=replace-with-a-long-random-cron-secret
# SMS is intentionally provider-agnostic. "disabled" queues no SMS delivery;
# "webhook" POSTs {to,message} to SMS_WEBHOOK_URL.
SMS_PROVIDER=disabled
# SMS_WEBHOOK_URL=https://sms-provider.example.com/send
# SMS_WEBHOOK_TOKEN=replace-me
# Optional Google/Facebook review destination shown after high ratings.
# PUBLIC_REVIEW_URL=https://g.page/r/your-business/review

# Website CMS
WEBSITE_PREVIEW_TTL_MINUTES=30

# Phase 9 - production operations
APP_RELEASE=local
LOG_LEVEL=info
AUDIT_LOG_RETENTION_DAYS=180
AUDIT_IP_SALT=change-me
MEDIA_WORKER_INTERVAL_MS=10000
ERROR_REPORTING_WEBHOOK_URL=
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=./backups
MONGODUMP_BIN=mongodump
HEALTH_SECRET=
CSP_REPORT_URI=

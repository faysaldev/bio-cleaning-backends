# Browser / CORS
FRONTEND_URL=http://localhost:3000
FRONT_END_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://api.opygen.cyou,https://biocleaning.faysaldev.com/

# Authentication & Sessions
JWT_SECRET=72b6597c9a90a5c88652494f37d6da57894888763d49cdlwfjoer234234
JWT_REFRESH_SECRET=72b6597c9a90a5c88652494f37d6da578948887werkjweor2342

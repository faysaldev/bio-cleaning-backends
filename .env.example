# Cloudflare R2 Object Storage (Images auto-compressed to WebP via Sharp)
# Obtain from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bio-cleaning-media
# Public CDN URL (e.g. https://pub-xxxx.r2.dev or custom domain https://media.yourdomain.com)
R2_PUBLIC_URL=https://pub-

# Stripe Payments
# Obtain Secret Key from Stripe Dashboard -> Developers -> API keys (e.g. sk_test_...)
STRIPE_SECRET_KEY=
# Obtain Webhook Signing Secret from Stripe Dashboard -> Developers -> Webhooks (whsec_...)
STRIPE_WEBHOOK_SECRET=
